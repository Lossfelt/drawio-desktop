{
  "appId": "lossfelt.drawio.archimate4fork",
  "productName": "draw.io ArchiMate4-fork",
  "copyright": "Copyright 2017-2026 draw.io Ltd",
  "asar": true,
  "files": [
    "**/*",
    "!**/WEB-INF{,/**}",
    "!drawio/src/main/webapp/stencils/**/*.xml",
    "!drawio/src/main/webapp/shapes{,/**}",
    "!drawio/src/main/webapp/js/diagramly{,/**}",
    "drawio/src/main/webapp/js/diagramly/{ElectronApp,DesktopLibrary}.js",
    "drawio/src/main/webapp/js/diagramly/ArchiMateQuickConnect.js",
    "drawio/src/main/webapp/js/diagramly/sidebar/Sidebar-ArchiMate4.js",
    "!drawio/src/main/webapp/js/grapheditor{,/**}",
    "!drawio/src/main/webapp/mxgraph/src{,/**}",
    "!drawio/src/main/webapp/mxgraph/mxClient.js",
    "!node_modules/@cantoo/pdf-lib/{cjs,dist,src,ts3.4}{,/**}",
    "!**/*.map"
  ],
  "directories": {
    "output": "./dist/archimate4-fork/"
  },
  "npmRebuild": false,
  "win": {
    "signtoolOptions": {
      "publisherName": ["JGraph Ltd", "draw.io Ltd"],
      "sign": "build/sign-trusted.mjs",
      "signingHashAlgorithms": ["sha256"]
    },
    "signExts": [".dll"],
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "artifactName": "${productName}-${version}-windows-installer.${ext}",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "runAfterFinish": false,
    "createDesktopShortcut": false
  },
  "afterPack": "build/fuses.mjs",
  "fileAssociations": []
}
